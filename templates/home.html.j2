{% extends "base.html.j2" %}

{% block page_title %}{{ site.title }} — {{ site.author }}{% endblock %}
{% block meta_description %}{{ page.description }}{% endblock %}
{% block canonical %}/{% endblock %}
{% block body_attrs %} class="page-home"{% endblock %}

{% block head_extra %}
<script type="application/ld+json">
{{ {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": site.author,
  "url": site.base_url,
  "description": page.description,
  "sameAs": site.social | map(attribute="url") | list
} | tojson }}
</script>
{% endblock %}

{% block content %}
<section class="hero">
  <div class="hero__text">
    <h1 class="hero__name">{{ site.author }}</h1>
    <div class="hero__lede">{{ page.body | safe }}</div>
  </div>
  {% if manifest.get("portrait/tim.jpg") %}
  {% set portrait = manifest["portrait/tim.jpg"] %}
  <figure class="hero__portrait">
    <picture>
      {% for source in portrait.sources %}
      <source type="{{ source.type }}" srcset="{{ source.srcset }}" sizes="(min-width: 48rem) 15rem, 9rem" />
      {% endfor %}
      <img src="{{ portrait.fallback.src }}"
           width="{{ portrait.width }}" height="{{ portrait.height }}"
           alt="Tim Arnold outdoors in a blue jacket and scarf, misty hills behind him."
           fetchpriority="high" decoding="async" />
    </picture>
  </figure>
  {% endif %}
</section>

<section class="lanes" aria-label="Sections">
  {% for lane in site.lanes %}
  <a class="lane lane--{{ lane.accent }}" href="/{{ lane.id }}.html">
    <span class="lane__label">{{ lane.title }}</span>
    <span class="lane__tagline">{{ lane.tagline }}</span>
    <span class="lane__index">
      {% if lane.id == 'tech' %}
        {% for article in articles[:3] %}
        <span class="lane__item">{{ article.title }}</span>
        {% endfor %}
        <span class="lane__more">{{ articles | length }} articles</span>
      {% else %}
        {% for gallery in galleries %}
        <span class="lane__item">{{ gallery.title }}</span>
        {% endfor %}
        <span class="lane__more">{{ galleries | map(attribute='pieces') | map('length') | sum }} pieces</span>
      {% endif %}
    </span>
    <span class="lane__enter">Enter <span aria-hidden="true">&rarr;</span></span>
  </a>
  {% endfor %}
</section>
{% endblock %}
