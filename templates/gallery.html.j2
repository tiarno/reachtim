{% extends "base.html.j2" %}
{% from "partials/_media.html.j2" import figure %}

{% block meta_description %}{{ page.summary }}{% endblock %}
{% block body_attrs %} class="page-gallery lane-art"{% endblock %}

{% block content %}
<header class="pagehead">
  <span class="pagehead__register" aria-hidden="true">
    {% include "partials/_register_art.svg" %}
  </span>
  <p class="eyebrow"><a href="/art.html">Art</a></p>
  <h1>{{ page.title }}</h1>
  <p class="pagehead__lede">{{ page.summary }}</p>
</header>

<div class="plates">
  {% for piece in page.pieces %}
  <figure class="plate">
    {# The grid serves lightweight derivatives; the link opens the full-size
       original, which for the math art is a large vector file. #}
    <a class="plate__frame" style="--mount: {{ page.mount }}" href="/static/img/{{ page.dir }}/{{ piece.file }}">
      {{ figure(manifest, page.dir, piece, "(min-width: 62rem) 30rem, (min-width: 40rem) 45vw, 92vw", eager=loop.index <= 2) }}
    </a>
    <figcaption class="plate__caption">
      <h2 class="plate__title">{{ piece.title }}</h2>
      <p>{{ piece.caption }}</p>
    </figcaption>
  </figure>
  {% endfor %}
</div>

<footer class="article__foot">
  <a class="backlink" href="/art.html"><span aria-hidden="true">&larr;</span> All collections</a>
</footer>
{% endblock %}
