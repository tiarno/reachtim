<?xml version="1.0" encoding="UTF-8"?>
{# Same path the old Pelican blog published its feed at, so existing subscribers keep working. #}
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="{{ site.locale }}">
  <title>{{ site.title }}</title>
  <subtitle>{{ site.description }}</subtitle>
  <link href="{{ site.base_url }}/feeds/all.atom.xml" rel="self" />
  <link href="{{ site.base_url }}/" rel="alternate" />
  <id>{{ site.base_url }}/</id>
  <updated>{{ build_time.strftime('%Y-%m-%dT%H:%M:%SZ') }}</updated>
  <author>
    <name>{{ site.author }}</name>
    <uri>{{ site.base_url }}</uri>
  </author>
{% for article in articles %}
  <entry>
    <title>{{ article.title }}</title>
    <link href="{{ site.base_url }}{{ article.url }}" rel="alternate" />
    <id>{{ site.base_url }}{{ article.url }}</id>
    <published>{{ article.date.isoformat() }}T00:00:00Z</published>
    <updated>{{ article.date.isoformat() }}T00:00:00Z</updated>
    <category term="{{ article.category }}" />
    <summary type="text">{{ article.summary }}</summary>
    <content type="html">{{ article.body }}</content>
  </entry>
{% endfor %}
</feed>
