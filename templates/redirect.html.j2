<!DOCTYPE html>
{#
  Stub for a URL the old Pelican blog published. This host serves static files
  only, so a 301 isn't available; rel=canonical tells crawlers where the article
  really lives and the refresh moves a human along immediately.
#}
<html lang="{{ site.locale }}">
  <head>
    <meta charset="utf-8" />
    <title>Moved — {{ page.title }}</title>
    <link rel="canonical" href="{{ site.base_url }}{{ target }}" />
    <meta name="robots" content="noindex, follow" />
    <meta http-equiv="refresh" content="0; url={{ target }}" />
  </head>
  <body>
    <p>This article moved to <a href="{{ target }}">{{ page.title }}</a>.</p>
  </body>
</html>
